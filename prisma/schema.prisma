// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id Int @id @default(autoincrement())
  name String
  managedById Int?

  manager Employee? @relation("ManagerReports", fields: [managedById], references: [id])

  reports Employee[] @relation("ManagerReports")
  attemptsTaken    Attempt[] @relation("AttemptBy")
  attemptsApproved Attempt[] @relation("ApprovedBy")
}

model Skill {
  id Int @id @default(autoincrement())
  skillName String @unique
  questions Question[]
  attempts Attempt[]
}

model Question {
  id Int @id @default(autoincrement())
  skill Skill @relation(fields: [skillId], references: [id])
  skillId Int
  proficiencyLevel Int
  questionType QuestionType
  questionContent String
  starterCode String?
  testCases TestCase[]
  attemptQuestion AttemptQuestion[]
}

model TestCase {
  id Int @id @default(autoincrement())
  question Question @relation(fields: [questionId], references: [id])
  questionId Int
  input String
  expectedOutput String
  visibility Visibility
}

model Attempt {
  id Int @id @default(autoincrement())
  employeeId Int
  approvedById Int?
  skillId Int
  proficiencyLevel Int
  status AttemptStatus
  createdAt DateTime @default(now())
  startTime DateTime?
  deadline DateTime?
  decision Decision?
  decisionReason String?
  gradingReport GradingReport?

  attemptBy Employee @relation("AttemptBy",fields: [employeeId], references: [id])
  approvedBy Employee? @relation("ApprovedBy", fields: [approvedById], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])
  questions AttemptQuestion[]
  events AttemptEvent[]
}

model AttemptQuestion {
  attemptId Int
  questionId Int
  position Int

  attempt Attempt @relation(fields: [attemptId], references: [id])
  question Question @relation(fields: [questionId], references: [id])
  submissions Submission[]

  @@id([attemptId, questionId])
  @@unique([attemptId, position])

}

model Submission {
  id Int @id @default(autoincrement())
  attemptId Int
  questionId Int
  submittedAnswer String
  isCorrect Boolean?
  submittedAt DateTime @default(now())
  gradingStatus GradingStatus?
  testResults   Json?

  attemptQuestion AttemptQuestion @relation(fields: [attemptId, questionId], references: [attemptId, questionId])
}

model AttemptEvent {
  id Int @id @default(autoincrement())
  type String
  serverTime DateTime @default(now())
  payload Json?
  attemptId Int
  
  attempt   Attempt @relation(fields: [attemptId], references: [id])
}

model GradingReport {
  id                Int      @id @default(autoincrement())
  attemptId         Int      @unique
  status GradingStatus @default(PENDING)
  totalTestCases    Int      @default(0)
  passedTestCases   Int      @default(0)
  score             Int?
  completedAt       DateTime?
  createdAt         DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id])
}
enum QuestionType {
  SCRATCH
  DEBUG
}

enum Visibility {
  VISIBLE
  HIDDEN_A
  HIDDEN_B
}

enum AttemptStatus {
  REQUESTED
  APPROVED
  CREATED
  IN_PROGRESS
  SUBMITTED
  GRADED
  DECIDED
}

enum Decision {
  APPROVED
  REJECTED
}


enum GradingStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}
